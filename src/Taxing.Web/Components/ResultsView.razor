@* Renders the computed ITR schedules as tabbed tables with export buttons. *@

<div class="d-flex align-items-center mb-3">
    <h2 class="me-auto mb-0">Results — AY @Result.Period.AssessmentYearLabel</h2>
    <button class="btn btn-success me-2" @onclick="OnDownloadExcel">Download Excel</button>
    <button class="btn btn-outline-success" @onclick="OnDownloadJson">Download JSON</button>
</div>

@if (Result.Warnings.Count > 0)
{
    <div class="alert alert-info">
        <strong>Notes &amp; assumptions:</strong>
        <ul class="mb-0">
            @foreach (var w in Result.Warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}

<ul class="nav nav-tabs mb-3">
    @foreach (var tab in _tabs)
    {
        <li class="nav-item">
            <button class="nav-link @(_active == tab ? "active" : "")" @onclick="() => _active = tab">
                @tab
            </button>
        </li>
    }
</ul>

@if (_active == "FA A2")
{
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead><tr>
                <th>Country</th><th>Institution</th><th>Account</th><th>Opened</th>
                <th class="text-end">Peak (INR)</th><th class="text-end">Closing (INR)</th>
                <th class="text-end">Gross Credited (INR)</th>
            </tr></thead>
            <tbody>
                @foreach (var a in Result.ScheduleFaA2)
                {
                    <tr>
                        <td>@a.CountryCodeItr</td><td>@a.InstitutionName</td><td>@a.AccountNumber</td>
                        <td>@a.AccountOpenedDate?.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@F(a.PeakBalanceInr)</td>
                        <td class="text-end">@F(a.ClosingBalanceInr)</td>
                        <td class="text-end">@F(a.GrossCreditedInr)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_active == "FA A3")
{
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead><tr>
                <th>Country</th><th>Entity</th><th>Acquired</th>
                <th class="text-end">Initial (INR)</th><th class="text-end">Peak (INR)</th>
                <th class="text-end">Closing (INR)</th><th class="text-end">Dividend (INR)</th>
                <th class="text-end">Proceeds (INR)</th>
            </tr></thead>
            <tbody>
                @foreach (var a in Result.ScheduleFaA3)
                {
                    <tr>
                        <td>@a.CountryCodeItr</td><td>@a.EntityName</td>
                        <td>@a.AcquisitionDate?.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@F(a.InitialValueInr)</td>
                        <td class="text-end">@F(a.PeakValueInr)</td>
                        <td class="text-end">@F(a.ClosingValueInr)</td>
                        <td class="text-end">@F(a.GrossDividendInr)</td>
                        <td class="text-end">@F(a.ProceedsInr)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_active == "FSI")
{
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead><tr>
                <th>Country</th><th>Head</th><th>Date</th>
                <th class="text-end">Income (INR)</th><th class="text-end">Foreign Tax (INR)</th>
                <th>Article</th><th class="text-end">FX Rate</th><th>Rate Date</th>
            </tr></thead>
            <tbody>
                @foreach (var f in Result.ScheduleFsi)
                {
                    <tr>
                        <td>@f.CountryCodeItr</td><td>@f.IncomeHead</td>
                        <td>@f.IncomeDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@F(f.IncomeInr)</td>
                        <td class="text-end">@F(f.ForeignTaxInr)</td>
                        <td>@f.TreatyArticle</td>
                        <td class="text-end">@f.FxRate</td>
                        <td>@f.FxRateDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_active == "TR / Form 67")
{
    <h5>Schedule TR</h5>
    <table class="table table-striped table-sm">
        <thead><tr>
            <th>Country</th><th class="text-end">Foreign Tax Paid (INR)</th>
            <th class="text-end">Relief Claimed (INR)</th><th>Section</th>
        </tr></thead>
        <tbody>
            @foreach (var t in Result.ScheduleTr)
            {
                <tr>
                    <td>@t.CountryCodeItr</td>
                    <td class="text-end">@F(t.ForeignTaxPaidInr)</td>
                    <td class="text-end">@F(t.ReliefClaimedInr)</td>
                    <td>@t.ReliefSection</td>
                </tr>
            }
        </tbody>
    </table>
    <h5 class="mt-3">Form 67 detail</h5>
    <table class="table table-striped table-sm">
        <thead><tr>
            <th>Country</th><th>Source</th><th class="text-end">Income (INR)</th>
            <th class="text-end">Foreign Tax (INR)</th><th>Article</th>
        </tr></thead>
        <tbody>
            @foreach (var f in Result.Form67)
            {
                <tr>
                    <td>@f.CountryCodeItr</td><td>@f.SourceOfIncome</td>
                    <td class="text-end">@F(f.IncomeInr)</td>
                    <td class="text-end">@F(f.ForeignTaxInr)</td>
                    <td>@f.TreatyArticle</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (_active == "Capital Gains")
{
    @if (Result.CapitalGains.Count == 0)
    {
        <p class="text-muted">No share sales in the financial year.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead><tr>
                    <th>Symbol</th><th>Acquired</th><th>Sold</th><th class="text-end">Qty</th>
                    <th class="text-end">Proceeds (INR)</th><th class="text-end">Cost (INR)</th>
                    <th class="text-end">Gain (INR)</th><th>Term</th><th class="text-end">Months</th>
                </tr></thead>
                <tbody>
                    @foreach (var g in Result.CapitalGains)
                    {
                        <tr>
                            <td>@g.Symbol</td>
                            <td>@g.AcquisitionDate.ToString("yyyy-MM-dd")</td>
                            <td>@g.SaleDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@g.Quantity</td>
                            <td class="text-end">@F(g.ProceedsInr)</td>
                            <td class="text-end">@F(g.CostInr)</td>
                            <td class="text-end">@F(g.GainInr)</td>
                            <td>@g.Term</td>
                            <td class="text-end">@g.HoldingMonths</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public ItrResult Result { get; set; } = default!;
    [Parameter] public EventCallback OnDownloadExcel { get; set; }
    [Parameter] public EventCallback OnDownloadJson { get; set; }

    private readonly string[] _tabs =
        { "FA A2", "FA A3", "FSI", "TR / Form 67", "Capital Gains" };
    private string _active = "FA A2";

    private static string F(decimal v) => v.ToString("N0");
}
